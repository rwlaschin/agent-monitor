{
  "name": "agent-monitor",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --host 0.0.0.0 --port 5500",
    "generate": "nuxt generate",
    "start": "PORT=5501 HOST=0.0.0.0 node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "pc": "process-compose -t=false --port 9999",
    "pc:tui": "process-compose --port 9999",
    "pc:down": "process-compose down"
  },
  "dependencies": {
    "@nuxtjs/color-mode": "^4.0.1",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^1.0.2",
    "chokidar": "^5.0.0",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.2",
    "vitest": "^4.1.10"
  }
}
